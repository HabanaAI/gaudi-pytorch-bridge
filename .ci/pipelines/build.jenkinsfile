def stableBranch = GERRIT_BRANCH - '_next'
def isPromote = env.IS_PROMOTE.toBoolean() || env.TRIGGER_BUILD.startsWith("Promote")
src = library("pipeline-library@$stableBranch")

def user_install = env.runInDocker == 'true' ? '' : '--user'
def buildDependencies = ['SYNAPSE', "SYNAPSE_UTILS", 'AEON', 'HL_THUNK', 'COMPLEX_GUID', 'SWTOOLS_SDK', 'SYNAPSE_PROFILER', 'TPC_KERNELS', 'SCAL', 'PT_FORK']

def preCommitValidation = [
    'Running pre-commit hooks': { util ->
        Integer precommitResult = util.runShellCommandWrapper("""
            set -xe
            __check_pytorch_dev_py_deps
            pushd \${PYTORCH_MODULES_ROOT_PATH}
            pre-commit run --color never --show-diff-on-failure --from HEAD^ --to HEAD
            popd
        """, null, false, true)
        if (precommitResult == 0) { return }
        else if (precommitResult == 1) {
            error("precommit hook failed - aborting build")
        }
        error("exception during precommit hook - aborting build")
    }
]
def ccacheStats = [
    'Print CCache statistics': { util ->
        util.runShellCommandWrapper("ccache --show-stats")
    }
]
def lightningHabanaFork = [
    'Build Lightning Habana fork': { util ->
        util.runBuildShell('build_lightning_habana_fork -c')
    }
]
def pytorchFork = [
    'Install Pytorchfork modules': { util ->
        util.runShellCommandWrapper("""
            set -xe
            __clean_pytorch_dev_py_deps
            pip install -U \${PYTORCH_FORK_RELEASE_BUILD}/pkgs/*torch*.whl ${user_install}
            rm \${PYTORCH_FORK_RELEASE_BUILD}/pkgs/*torch*.whl
        """)
    }
]
def preBuildStages = [
    'Install Python test dependencies': { util ->
        util.runShellCommandWrapper("""
            set -x
            __check_pytorch_dev_py_deps
        """)
    }
]
preBuildStages = preBuildStages + ccacheStats + pytorchFork + ccacheStats
if(env.GERRIT_PROJECT == 'pytorch-integration' && !isPromote) {
    preBuildStages = preCommitValidation + preBuildStages
}
if((env.GERRIT_PROJECT == 'lightning-habana-fork' ) && !isPromote) {
    preBuildStages =  preBuildStages + lightningHabanaFork
}
preBuildStages =  preBuildStages + lightningHabanaFork + ccacheStats
def buildCommands = [
    'Pytorch vision fork': 'build_pytorch_vision_fork -c',
    'Pytorch modules': 'build_pytorch_modules -c'
]

def testDependencies = ['CORAL_SIM', 'TPCSIM', 'TPC_FUSER', 'TPC_LLVM', 'HCL', 'MEDIA', 'CODEC', 'RDMA_CORE', 'DEEPSPEED_FORK']
def requiredArtifact = [
    'SWTOOLS_SDK': ['bin', 'shared'],
    'SYNAPSE': ['test', 'shared', 'header'],
    'SYNAPSE_PROFILER': ['bin', 'shared'],
    "SYNAPSE_UTILS" : ['shared', 'bin'],
    'COMPLEX_GUID': ['test', 'shared'],
    'HL_THUNK': ['test', 'shared', 'header'],
    'TPCSIM': ['shared', 'header'],
    'ELFTOOLS': ['shared'],
    'TPC_KERNELS': ['test', 'shared'],
    'TPC_FUSER': ['bin', 'shared'],
    'TPC_LLVM': ['bin', 'shared', 'header'],
    'SCAL': ['test', 'shared', 'header'],
    'PYTORCH': ['test', 'data', 'header'],
    'CORAL_SIM': ['bin', 'bin_nextgen', 'test', 'shared', 'header'],
    'AEON': ['shared', 'header'],
    'ENGINES_FW': ['config', 'data', 'shared', 'test'],
    'HCL': ['shared'],
    'HVL_MEDIA': ['shared'],
    'MEDIA': ['test', 'shared'],
    'CODEC': ['shared'],
    'FFMPEG_FORK': ['shared'],
    'RDMA_CORE': ['test']
]

genericBuilder(
    src: src,
    preBuildStages: preBuildStages,
    buildDependencies: buildDependencies,
    buildCommands: buildCommands,
    testDependencies: testDependencies,
    requiredArtifact: requiredArtifact,
    manifest: manifest
)
