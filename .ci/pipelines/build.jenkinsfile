def stableBranch = GERRIT_BRANCH - '_next'
src = library("pipeline-library@$stableBranch")

def user_install = env.runInDocker == 'true' ? '' : '--user'
def buildDependencies = ['SYNAPSE', "SYNAPSE_UTILS", 'AEON', 'HL_THUNK', 'COMPLEX_GUID', 'SWTOOLS_SDK', 'SYNAPSE_PROFILER', 'TPC_KERNELS', 'SCAL']
def clangFormatValidation = [
    'clang-format validation': { util ->
        try {
            util.createPatchClangformatDiff()
        } catch(err) {
            archiveArtifacts artifacts: "repos/${GERRIT_PROJECT}/clang_format_diff_${GERRIT_CHANGE_NUMBER}.patch" , fingerprint: true, allowEmptyArchive: true
            throw err
        }
    }
]
def checkYAMLLinter = [
    'YAML file validation': { util ->
        util.runShellCommandWrapper("""
            __check_pytorch_dev_py_deps
            yamllint -c \${PYTORCH_MODULES_ROOT_PATH}/.yamllint \${PYTORCH_MODULES_ROOT_PATH}/scripts/hpu_op.yaml
        """)
    }
]
def pytorchLightningFork = [
    'Build Pytorch lightning fork': { util ->
        util.runShellCommandWrapper('rm -rf ${PYTORCH_LIGHTNING_FORK_ROOT}/dist/*.whl')
        util.runBuildShell('build_pytorch_lightning_fork')
    }
]
def habanaLightningPlugins = [
    'Build Habana lightning Plugins': { util ->
        util.runShellCommandWrapper('rm -rf ${HABANA_LIGHTNING_PLUGINS_BUILD}/dist/*.whl')
        util.runBuildShell('build_habana_lightning_plugins')
    }
]
def buildPytorchModulesNext = [
    'Build Pytorch Modules Next': { util ->
        util.runBuildShell('build_pytorch_modules --pt-version next')
        util.runShellCommandWrapper('mv ${PYTORCH_MODULES_RELEASE_BUILD} ${BUILD_ROOT}/builds_next')
    }
]
def preBuildStages = [
    'Install Python test dependencies': { util ->
        util.runShellCommandWrapper("""
            set -x
            __check_pytorch_dev_py_deps
        """)
    },
    'Clean Old .whl pakages': { util ->
        util.runShellCommandWrapper('rm -rf ${PYTORCH_FORK_ROOT}/dist/*.whl')
        util.runShellCommandWrapper('rm -rf ${PYTORCH_VISION_FORK_ROOT}/dist/*.whl')
        util.runShellCommandWrapper('rm -rf ${PYTORCH_MODULES_ROOT_PATH}/dist/*.whl')
        util.runShellCommandWrapper('rm -rf ${PYTORCH_LIGHTNING_FORK_ROOT}/dist/*.whl')
        util.runShellCommandWrapper('rm -rf ${HABANA_LIGHTNING_PLUGINS_BUILD}/dist/*.whl')
    },
    'Build Pytorchfork modules': { util ->
        util.runBuildShell('build_pytorch_fork --dist')
        util.runShellCommandWrapper("""
            set -xe
            __clean_pytorch_dev_py_deps
            pip install -U \${PYTORCH_FORK_RELEASE_BUILD}/pkgs/*torch*.whl ${user_install}
        """)
    }
]
if(env.GERRIT_PROJECT == 'pytorch-integration' && !env.isPromote) {
    preBuildStages = clangFormatValidation + checkYAMLLinter + preBuildStages
}
if((env.GERRIT_PROJECT == 'pytorch-lightning-fork' || env.GERRIT_PROJECT == 'Habana-Lightning-Plugins' ) && !env.isPromote) {
    preBuildStages =  preBuildStages + pytorchLightningFork
}
preBuildStages =  preBuildStages + habanaLightningPlugins
// TODO: SW-127368: compile PT 2.0 only in CI and for promote only for U20. This is temporary hack, untill issues fixed by dev.
if(env.OS == 'ubuntu20.04'){
    preBuildStages =  preBuildStages + buildPytorchModulesNext
}
def buildCommands = [
    'Pytorch vision fork': 'build_pytorch_vision_fork',
    'Pytorch modules': 'build_pytorch_modules'
]
def testDependencies = ['CORAL_SIM', 'TPCSIM', 'TPC_FUSER', 'TPC_LLVM', 'HCL', 'FUNC_SIM5']
def requiredArtifact = [
    'SWTOOLS_SDK': ['bin', 'shared'],
    'SYNAPSE': ['test', 'shared'],
    'SYNAPSE_PROFILER': ['bin', 'shared'],
    "SYNAPSE_UTILS" : ["shared"],
    'COMPLEX_GUID': ['test', 'shared'],
    'HL_THUNK': ['test', 'shared'],
    'TPCSIM': ['shared', 'header'],
    'ELFTOOLS': ['shared'],
    'TPC_KERNELS': ['test', 'shared'],
    'TPC_FUSER': ['bin', 'shared'],
    'TPC_LLVM': ['bin', 'shared'],
    'SCAL': ['test', 'shared'],
    'PYTORCH': ['test', 'data'],
    'CORAL_SIM': ['bin', 'bin_nextgen', 'test', 'shared', 'header'],
    'AEON': ['shared'],
    'ENGINES_FW': ['config', 'data', 'shared', 'test'],
    'HCL': ['shared'],
    'FUNC_SIM5': ['bin', 'test', 'static']
]

genericBuilder(
    src: src,
    preBuildStages: preBuildStages,
    buildDependencies: buildDependencies,
    buildCommands: buildCommands,
    testDependencies: testDependencies,
    requiredArtifact: requiredArtifact,
    manifest: manifest
)
