{
  "profiles": {
    "ci": {
      "wheels": [
        "ci"
      ],
      "additional_build_flags": [
        "-c",
        "-r",
        "--no-iwyu",
        "--recreate-venv=force",
        "-v"
      ]
    },
    "cd": {
      "wheels": [
        "release"
      ],
      "additional_build_flags": [
        "-c",
        "-r",
        "--no-iwyu",
        "--recreate-venv=force",
        "-v"
      ]
    }
  },
  "required_pt": {
    "default": "torch"
  },
  "pt_versions": {
    "previous": {
      "version": "2.8.0",
      "default_source": "build",
      "cpu_index_url": "default",
      "extras": {
        "torchvision": "v0.23.0",
        "torchdata": "v0.11.0"
      }
    },
    "current": {
      "version": "2.9.0",
      "default_source": "build",
      "cpu_index_url": "default",
      "extras": {
        "torchvision": "v0.24.0",
        "torchdata": "v0.11.0"
      }
    },
    "next": {
      "version": "2.10.0",
      "default_source": "build",
      "cpu_index_url": "https://download.pytorch.org/whl/test/cpu",
      "extras": {
        "torchvision": "main",
        "torchdata": "v0.11.0"
      }
    },
    "rc": {
      "version": null,
      "default_source": "https://download.pytorch.org/whl/test/cpu"
    },
    "future": {
      "version": "2.10.0",
      "default_source": "https://download.pytorch.org/whl/nightly/cpu"
    },
    "nightly": {
      "version": "nightly",
      "default_source": "https://download.pytorch.org/whl/nightly/cpu"
    }
  },
  "wheels": {
    "release": {
      "wheel_name": "habana_torch_plugin",
      "pt_versions": [
        "current"
      ]
    },
    "ci": {
      "wheel_name": "habana_torch_plugin",
      "pt_versions": [
        "current",
        "rc"
      ]
    },
    "internal": {
      "wheel_name": "habana_torch_plugin_internal",
      "pt_versions": [
        "rc"
      ],
      "continue_on_error": true
    }
  }
}
