{
  "profiles": {
    "ci": {
      "wheels": [
        "ci"
      ],
      "additional_build_flags": [
        "-c",
        "-r",
        "--no-iwyu",
        "--recreate-venv=force",
        "-v",
        "--op-stats"
      ]
    },
    "cd": {
      "wheels": [
        "release"
      ],
      "additional_build_flags": [
        "-c",
        "-r",
        "--no-iwyu",
        "--recreate-venv=force",
        "-v",
        "--op-stats"
      ]
    }
  },
  "required_pt": {
    "default": "torch"
  },
  "pt_versions": {
    "current": {
      "version": "2.1.0",
      "default_source": "build",
      "extras" : {
          "torchvision": "0.16.0",
          "torchaudio": "2.1.0",
          "torchtext": "0.16.0",
          "torchdata": "0.7.0"
      }
    },
    "previous": {
      "version": null,
      "default_source": "build"
    },
    "next": {
      "version": "2.2.0",
      "default_source": "build",
      "extras" : {
          "torchvision": "0.16.0",
          "torchaudio": "2.1.0",
          "torchtext": "0.16.0",
          "torchdata": "0.7.0"
      }
    },
    "rc": {
      "version": null,
      "default_source": "https://download.pytorch.org/whl/test/cpu"
    },
    "future": {
      "version": "2.2.0",
      "default_source": "https://download.pytorch.org/whl/nightly/cpu"
    },
    "nightly": {
      "version": "nightly",
      "default_source": "https://download.pytorch.org/whl/nightly/cpu"
    }
  },
  "wheels": {
    "release": {
      "wheel_name": "habana_torch_plugin",
      "pt_versions": [
        "current",
        "previous"
      ]
    },
    "ci": {
      "wheel_name": "habana_torch_plugin",
      "pt_versions": [
        "current",
        "previous",
        "rc"
      ]
    },
    "internal": {
      "wheel_name": "habana_torch_plugin_internal",
      "pt_versions": [
        "rc"
      ],
      "continue_on_error": true
    }
  }
}
