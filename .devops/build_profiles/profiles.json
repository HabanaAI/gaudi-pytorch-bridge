{
  "profiles": {
    "ci": {
      "wheels": ["ci"],
      "additional_build_flags": [
        "-c", "-r", "--no-tidy", "--no-iwyu", "--recreate-venv=as_needed", "--manylinux",
        "-v", "--python-versions=3.8", "--run-ctest"
      ]
    },
    "npu-stack": {
      "wheels": ["release"],
      "additional_build_flags": [
        "-c", "-r", "--no-tidy", "--no-iwyu", "--recreate-venv=as_needed",
        "-v", "--python-versions=3.8"
      ]
    },
    "cd": {
      "wheels": ["release", "internal"],
      "additional_build_flags": [
        "-c", "-r", "--no-tidy", "--no-iwyu", "--recreate-venv=force", "--manylinux",
        "-v", "--python-versions=all", "--build-dbgsym-whl"
      ]
    },
    "cd-vm": {
      "wheels": ["release"],
      "additional_build_flags": [
        "-c", "-r", "--no-tidy", "--no-iwyu", "--recreate-venv=force",
        "-v", "--python-versions=3.8"
      ]
    },
    "daily": {
      "wheels": ["release"],
      "additional_build_flags": [
        "-c", "-r", "--no-tidy", "--no-iwyu", "--recreate-venv=force", "--manylinux",
        "-v", "--python-versions=3.8"
      ]
    }
  },
  "required_pt": {
    "default": "torch"
  },
  "pt_versions": {
    "current": {
      "version": "1.12.0"
    },
    "previous": {
      "version": "1.12.0+cpu"
    },
    "rc": {
      "version": "1.13.0rc3+cpu"
    },
    "nightly": {
      "version": "nightly"
    }
  },
  "required_pt": {
    "default": "pytorch",
    "nightly": "pt-nightly"
  },
  "suffix": null,
  "wheels": {
    "release": {
      "wheel_name": "habana_torch_plugin",
      "pt_versions": ["current", "previous"]
    },
    "ci": {
      "wheel_name": "habana_torch_plugin",
      "pt_versions": ["current", "previous", "rc"]
    },
    "internal": {
      "wheel_name": "habana_torch_plugin_internal",
      "pt_versions": ["rc"],
      "continue_on_error": true
    }
  }
}
