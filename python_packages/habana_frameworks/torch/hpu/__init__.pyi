from typing_extensions import Self

from torch.types import Device, _bool, _device, _float, _int

def init() -> None: ...
def is_available() -> bool: ...
def device_count() -> int: ...
def get_device_type() -> int: ...
def is_initialized() -> bool: ...
def get_device_name(device: Device | None = None) -> str: ...
def current_device() -> int: ...
def synchronize() -> None: ...
def is_bf16_available() -> bool: ...
def get_device_capability() -> str: ...
def get_device_properties(device: Device | None = None) -> str: ...
def can_device_access_peer(device: Device, peer_device: Device) -> bool: ...
def get_arch_list() -> list[str]: ...
def get_gencode_flags() -> str: ...

class device:
    type: str  # THPDevice_type
    index: _int  # THPDevice_index

class Stream:
    stream_id: _int  # Stream id
    device_index: _int
    device_type: _int

    device: device  # The device of the stream

# Defined in habana_frameworks/torch/hpu/csrc/Stream.cpp
class _HpuStreamBase(Stream):
    stream_id: _int
    device_index: _int
    device_type: _int

    device: _device
    hpu_stream: _int
    priority: _int

    def __new__(
        cls,
        priority: _int = 0,
        stream_id: _int = 0,
        device_index: _int = 0,
        stream_ptr: _int = 0,
    ) -> Self: ...
    def query(self) -> _bool: ...
    def synchronize(self) -> None: ...

# Defined in habana_frameworks/torch/hpu/csrc/Event.cpp
class _HpuEventBase:
    device: _device
    hpu_event: _int

    def __new__(cls, enable_timing: _bool = False) -> Self: ...
    def record(self, stream: _HpuStreamBase) -> None: ...
    def wait(self, stream: _HpuStreamBase) -> None: ...
    def query(self) -> _bool: ...
    def elapsed_time(self, other: _HpuEventBase) -> _float: ...
    def synchronize(self) -> None: ...
