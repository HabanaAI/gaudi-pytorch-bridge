[FORMAT]
max-line-length=120

[MASTER]
disable=
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
		E0401,  # import-error
    W1203,  # logging-fstring-interpolation -- reenable if we want more performant logging

[MISCELLANEOUS]
notes=
